# ╔═══════════════════════════════════════════════════════════════╗
# ║  THESORIA BACKEND - VARIABLES D'ENVIRONNEMENT                 ║
# ║  Copier ce fichier vers backend/.env et remplir les valeurs  ║
# ║  ⚠️  NE JAMAIS COMMIT LE FICHIER .env (secrets dedans)       ║
# ╚═══════════════════════════════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENVIRONMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Options: development, testnet, production
ENVIRONMENT=development

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WALLET (⚠️  ULTRA CRITIQUE - SÉCURITÉ MAXIMALE)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚠️  Utiliser un wallet DÉDIÉ uniquement pour le bot
# ⚠️  NE JAMAIS partager cette clé
# ⚠️  Faire PLUSIEURS backups sécurisés
# ⚠️  Considérer utiliser un coffre-fort de secrets (AWS Secrets Manager, etc.)

WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE_NEVER_SHARE_THIS

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RPC ENDPOINTS (Obtenir gratuitement sur Alchemy/Infura)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ethereum Mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optimism
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Avalanche
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TRADING PARAMETERS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Maximum trade size (ETH)
# 🔴 PRODUCTION: Commencer TRÈS PETIT (0.1) puis augmenter progressivement
MAX_TRADE_SIZE=0.1

# Minimum profit threshold (USD)
MIN_PROFIT_USD=20

# Maximum gas price (Gwei)
MAX_GAS_GWEI=80

# Maximum slippage tolerance (%)
MAX_SLIPPAGE_PCT=1.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RISK MANAGEMENT (🛡️  PROTECTION)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Maximum daily loss (USD) - Le bot s'arrête si atteint
MAX_DAILY_LOSS=200

# Stop-loss per trade (%)
STOP_LOSS_PCT=5

# Maximum consecutive losses before auto-pause
MAX_CONSECUTIVE_LOSSES=5

# Minimum wallet balance to keep (ETH) - Buffer pour gas
MIN_WALLET_BALANCE=0.05

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PERFORMANCE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Scan interval (seconds)
SCAN_INTERVAL=5

# Price update interval (seconds)
PRICE_UPDATE_INTERVAL=3

# Number of concurrent workers
NUM_WORKERS=10

# Request timeout (seconds)
REQUEST_TIMEOUT=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WEBSOCKET
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

WS_HOST=0.0.0.0
WS_PORT=8765

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MONITORING & ALERTS (OPTIONNEL mais RECOMMANDÉ)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Telegram Bot
# 1. Parler à @BotFather sur Telegram pour créer un bot
# 2. Obtenir le token
# 3. Parler à @userinfobot pour obtenir votre chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (alternative)
# 1. Créer un webhook dans Discord Server Settings > Integrations
DISCORD_WEBHOOK_URL=

# Sentry (error tracking)
SENTRY_DSN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOGGING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# Log file max size (bytes)
LOG_FILE_MAX_BYTES=10485760

# Number of backup log files
LOG_FILE_BACKUP_COUNT=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEX SELECTION (true/false)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ENABLE_UNISWAP_V2=true
ENABLE_UNISWAP_V3=true
ENABLE_SUSHISWAP=true
ENABLE_CURVE=true
ENABLE_BALANCER=true
ENABLE_PANCAKESWAP=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FEATURES FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Auto trading (false = monitor only, no execution)
ENABLE_AUTO_TRADING=true

# Flashbots (protection MEV)
ENABLE_FLASHBOTS=false

# MEV protection
ENABLE_MEV_PROTECTION=true

# Gas optimization
ENABLE_GAS_OPTIMIZATION=true

# Simulation mode (true = no real transactions, for testing)
# 🟡 Mettre à false SEULEMENT en production après tests approfondis
SIMULATION_MODE=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 📌 CHECKLIST AVANT PRODUCTION:
# 
# □ WALLET_PRIVATE_KEY configuré (wallet dédié)
# □ RPC URLs configurés (Alchemy/Infura)
# □ MAX_TRADE_SIZE PETIT (0.1 ETH pour commencer)
# □ MAX_DAILY_LOSS configuré (protection)
# □ TELEGRAM_BOT_TOKEN configuré (alertes)
# □ SIMULATION_MODE=false (pour vraies transactions)
# □ ENABLE_AUTO_TRADING=true (pour exécution auto)
# □ Testé sur testnet d'abord
# □ Backups des clés faits
# □ Monitoring configuré
#
# 🚀 BON TRADING!
