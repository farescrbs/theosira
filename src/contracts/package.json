{
  "name": "thesoria-flashbot-contracts",
  "version": "1.0.0",
  "description": "Smart contracts FlashBot pour la plateforme THESORIA DeFi",
  "author": "THESORIA Team",
  "license": "MIT",
  "keywords": [
    "defi",
    "flash-loan",
    "arbitrage",
    "aave",
    "polygon",
    "gnosis"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:gnosis": "hardhat run scripts/deploy.js --network gnosis",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "verify:polygon": "hardhat verify --network polygon",
    "verify:gnosis": "hardhat verify --network gnosis",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "hardhat": "^2.19.4",
    "dotenv": "^16.3.1"
  },
  "dependencies": {
    "@aave/core-v3": "^1.19.3",
    "@openzeppelin/contracts": "^5.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "ethers": "^5.7.2"
  }
}